# Copy to .env.local / .env.development / .env.production and edit.
# Selected by APP_ENV (see app.config.js and the npm scripts).

# Base URL of the Laravel API, including the /api suffix.
API_URL=http://192.168.100.6:8000/api

# Short label shown in the in-app environment badge.
ENV_LABEL=LOCAL

# App name shown under the launcher icon.
APP_DISPLAY_NAME=SPS Local

# Axios request timeout in milliseconds.
REQUEST_TIMEOUT_MS=20000

# Show the environment badge in the app UI (hide for production).
SHOW_ENV_BADGE=true

# Allow plain http:// on Android release builds. Required for LAN testing
# against `php artisan serve`; must stay false for any https deployment.
ANDROID_ALLOW_CLEARTEXT=true
