# LOCAL — Laravel running on this machine (php artisan serve).
#
# Which address works depends on where the app runs:
#   browser on this machine  ->  http://127.0.0.1:8000/api
#   phone (Expo Go / APK)    ->  http://<your LAN IP>:8000/api   (ipconfig; start Laravel with --host=0.0.0.0)
#   Android emulator         ->  http://10.0.2.2:8000/api
API_URL=http://127.0.0.1:8000/api
ENV_LABEL=LOCAL
APP_DISPLAY_NAME=SPS Local
REQUEST_TIMEOUT_MS=20000
SHOW_ENV_BADGE=true
ANDROID_ALLOW_CLEARTEXT=true
