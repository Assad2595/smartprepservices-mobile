{
  "name": "sps-mobile",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "private": true,
  "scripts": {
    "start": "cross-env APP_ENV=local expo start",
    "start:local": "cross-env APP_ENV=local expo start",
    "start:dev": "cross-env APP_ENV=dev expo start",
    "start:prod": "cross-env APP_ENV=prod expo start",
    "web": "cross-env APP_ENV=local expo start --web",
    "android": "cross-env APP_ENV=local expo start --android",
    "ios": "cross-env APP_ENV=local expo start --ios",
    "config:local": "cross-env APP_ENV=local expo config --type public",
    "config:dev": "cross-env APP_ENV=dev expo config --type public",
    "config:prod": "cross-env APP_ENV=prod expo config --type public",
    "apk:local": "cross-env APP_ENV=local eas build --platform android --profile local --local",
    "apk:dev": "cross-env APP_ENV=dev eas build --platform android --profile dev --local",
    "apk:prod": "cross-env APP_ENV=prod eas build --platform android --profile prod --local",
    "build:local": "cross-env APP_ENV=local eas build --platform android --profile local",
    "build:dev": "cross-env APP_ENV=dev eas build --platform android --profile dev",
    "build:prod": "cross-env APP_ENV=prod eas build --platform android --profile prod",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src App.tsx --ext .ts,.tsx"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "axios": "^1.7.9",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.0",
    "expo-image-picker": "~16.0.6",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.12",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~8.0.1",
    "typescript": "~5.3.3"
  }
}
